// The main file: the data product's identity, its registered protocols, and their tests.
{
  "data_product_definition": {
    "name": "fc-clinic",
    "title": "Clinic FC (example)",
    "description": "A tiny fictional clinic data product used to teach FC authoring.",
    "entity_name_singular": "encounter",
    "entity_name_plural": "encounters"
  },

  "protocols": [
    "protocols/protocol_bp_by_department.json",
    "protocols/protocol_python_bp.json",
    "protocols/protocol_rmd_bp.json",
    // The ipynb (Jupyter notebook) plugin is kept as a REFERENCE but not registered: rendering it
    // shells out to the `jupyter` CLI, which must be installed and on PATH locally (a pip install of
    // the Python SDK's deps does not guarantee the `jupyter` launcher on PATH). Re-register this and
    // tests/test_ipynb_bp.json once you have Jupyter available. See protocols/plugins/plugin_bp_ipynb.py.
    // "protocols/protocol_ipynb_bp.json",
    "protocols/protocol_lab_results.json",
    "protocols/protocol_python_lab_results.json",
    "protocols/protocol_download.json"
  ],

  "tests": [
    // First: the empty-cohort download must succeed (headers, no rows) — guards the 0-entity NPE fix.
    "tests/test_download_empty_cohort.json",
    "tests/test_bp_by_department.json",
    "tests/test_python_bp.json",
    "tests/test_rmd_bp.json",
    // Disabled with its protocol above — needs a local `jupyter` CLI on PATH. Re-enable both together.
    // "tests/test_ipynb_bp.json",
    "tests/test_lab_results.json",
    "tests/test_python_lab_results.json",
    "tests/test_cohort_cardiology.json",
    "tests/test_download.json",
    "tests/test_download_all_genotypes.json"
  ]
}

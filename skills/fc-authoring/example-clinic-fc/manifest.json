// The manifest ties one deployable instance together: the data model to build, and what to serve.
// Build from the example-clinic-fc/ directory (paths are relative to it).
{
  "data_product_definition": {
    "name": "fc-clinic",
    "title": "Clinic FC (example)",
    "description": "A tiny fictional clinic data product used to teach FC authoring.",
    "entity_name_singular": "encounter",
    "entity_name_plural": "encounters",
    // The terms the data is used under; served by /s.
    "license": {
      "name": "CC0 1.0 (fictional example data)",
      "url": "https://creativecommons.org/publicdomain/zero/1.0/"
    }
  },

  "data_model": {
    "config": "config/config.json",
    "data_dir": "./",
    // Post-load transformers that add computed collections (see references/transformers.md).
    "transformers": "config/transformers.json",
    "log": "build.log"
  },

  "serve": {
    "main": "main.json",
    // Run the registered/auto tests on startup (they execute asynchronously — wait for them).
    "run_tests": "true"
  },

  "archive": "archive.ser"
}

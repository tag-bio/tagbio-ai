// "single_valued": true marks a field that must hold one value per entity; the build fails if a
// second value arrives (a duplicate row, another table writing the same collection). Conditions is
// deliberately multi-valued, so it is not marked.
[
  {
    "parser_type": "categorical-map",
    "column": "sex",
    "map": {
      "F": "Female",
      "M": "Male"
    },
    "collection": "Sex",
    "single_valued": true
  },
  {
    "parser_type": "categorical",
    "column": "region",
    "collection": "Patient Region",
    "single_valued": true
  },
  {
    "parser_type": "numeric",
    "column": "age",
    "collection": "Patient Age",
    "single_valued": true,
    "variable": "Patient Age"
  },
  {
    "parser_type": "categorical-delimited",
    "column": "conditions",
    "delimiter": "|",
    "collection": "Conditions"
  }
]
